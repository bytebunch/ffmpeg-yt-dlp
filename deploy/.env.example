# Media Service configuration (SPEC §13). install.sh writes .env from this file on the first
# install and fills in the values marked [install]; later runs only change IMAGE_TAG.
# Empty values mean "use the default". Restart after changes: docker compose up -d

# --- Stack ---------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=media
# local-db, local-redis: bundled Postgres/Redis. proxy: bundled nginx on HTTP_PORT.
COMPOSE_PROFILES=local-db,local-redis,proxy
# [install] e.g. ghcr.io/<owner>/media-service
MEDIA_IMAGE=
# [install] git SHA of the running release
IMAGE_TAG=
# host directory for output files (a separate volume in production)
MEDIA_FILES_PATH=./files
# bundled proxy port
HTTP_PORT=8085
# 127.0.0.1: this server only (the default). 0.0.0.0 opens the port to every network, plain HTTP;
# set PUBLIC_BASE_URL to match. Or keep 127.0.0.1 behind your own nginx (nginx/front.conf).
HTTP_BIND=127.0.0.1
# API inside the stack; published on 127.0.0.1 only
API_PORT=3000

# --- Infrastructure and secrets ---------------------------------------------------------------
# [install] e.g. https://dl.example.com — used in links and OAuth
PUBLIC_BASE_URL=
# bundled Postgres
POSTGRES_USER=ytdlp_app
POSTGRES_DB=media
# [install] openssl rand -hex 24
POSTGRES_PASSWORD=
# [install] postgres://ytdlp_app:<password>@postgres:5432/media
DATABASE_URL=
# separate migration role; defaults to DATABASE_URL
# DATABASE_MIGRATION_URL=
# disable | require | verify-ca | verify-full (external DBs)
# DATABASE_SSL_MODE=disable
# DATABASE_SSL_CA_FILE=
# DATABASE_POOL_MAX=10
# rediss:// for TLS
REDIS_URL=redis://redis:6379
# [install] openssl rand -base64 32
LINK_SIGNING_SECRET=
# [install] v1:<openssl rand -base64 32>; add v2:... to rotate
TOKEN_ENCRYPTION_KEYS=
# BACKUP_ENABLED=true
# BACKUP_HOUR=3
# BACKUP_RETENTION_DAYS=14
# healthchecks.io (or similar) URL pinged after each dump; "<url>/fail" when one fails
# BACKUP_PING_URL=
# Daily canary (canary.sh, DEPLOY.md §4.10): its API key, and a URL pinged after each run
# CANARY_API_KEY=
# CANARY_PING_URL=
# NGINX_INTERNAL_FILES_PREFIX=/_files/
# Drive delivery (DEPLOY.md §4.7); empty = Drive off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# --- worker-ff resources (Compose only) -----------------------------------------------------
# CPUs worker-ff may use (e.g. 6 on an 8-vCPU host); 0 = no limit.
WORKER_FF_CPUS=0
# Memory cap for worker-ff (e.g. 8g); 0 = no limit. With a cap the kernel kills ffmpeg, not Postgres.
WORKER_FF_MEMORY=0

# --- Whisper models (written by models.sh on install) ---------------------------------------
FFMPEG_WHISPER_MODELS=
FFMPEG_WHISPER_DEFAULT_MODEL=
FFMPEG_WHISPER_VAD_MODEL=

# --- Limits and quotas (defaults shown) ---------------------------------------------------------
# DOWNLOAD_CONCURRENCY=4
# FFMPEG_CONCURRENCY=2
# FFMPEG_THREADS=4
# none | vaapi | nvenc | qsv
# FFMPEG_HWACCEL=none
# USER_MAX_CONCURRENT_ITEMS=2
# USER_MAX_ITEMS_PER_DAY=300
# USER_MAX_PROCESS_MINUTES_PER_DAY=600
# USER_MAX_UPLOAD_MB_PER_DAY=20480
# PLAYLIST_MAX_ITEMS=100
# PLAYLIST_MAX_TOTAL_DURATION_HOURS=24
# PLAYLIST_UNKNOWN_DURATION_MINUTES=10
# PLAYLIST_EXPAND_TIMEOUT_SECONDS=120
# PLAYLIST_CACHE_TTL_MINUTES=60
# BATCH_MAX_URLS=50
# API_RATE_LIMIT_PER_MINUTE=120
# MAX_MEDIA_DURATION_MINUTES=240
# MAX_FILE_SIZE_MB=4096
# MAX_UPLOAD_SIZE_MB=4096
# UPLOAD_TTL_HOURS=24
# INPUT_CACHE_HOURS=6
# PROBE_MAX_MB=64
# COMMENTS_SYNC_MAX=200
# JOB_TIMEOUT_MINUTES=60
# RECIPE_TIMEOUT_BASE_MINUTES=5
# RECIPE_TIMEOUT_FACTOR=2.0
# RECIPE_MAX_COST=5000
# RECIPE_MAX_STEPS=25
# RECIPE_MAX_INPUTS=20
# RECIPE_MAX_OUTPUTS=10
# RECIPE_MAX_TEXT_LAYERS=8
# REVERSE_MAX_SECONDS=60
# INTERPOLATE_MAX_SECONDS=120
# GIF_MAX_SECONDS=30
# FRAMES_MAX_COUNT=2000
# LIVE_MAX_DURATION_MINUTES=360
# LIVE_MAX_WAIT_MINUTES=720
# 0 = unlimited
# JOB_RATE_LIMIT_MAX_KBPS=0
# TRANSCRIPT_TIMEOUT_SECONDS=60
# FILE_TTL_DAYS=7
# DISK_QUOTA_PERCENT=80
# OAUTH_STATE_TTL_MINUTES=10
# WATCH_MIN_INTERVAL_MINUTES=30
# WATCH_MAX_NEW_ITEMS=20
# WATCH_MAX_FAILURES=5
# comma-separated extractor names; empty = all built-in except generic
# SITE_ALLOWLIST=

# --- yt-dlp behaviour -----------------------------------------------------------------------------
# chrome | chrome-android | safari | safari-ios | edge | firefox | none
# YTDLP_IMPERSONATE_DEFAULT=chrome
# The bundled pot-provider service; empty disables PO tokens.
YTDLP_POT_PROVIDER_URL=http://pot-backend:4416
# YTDLP_ALLOWED_PLAYER_CLIENTS=
# YTDLP_SLEEP_REQUESTS_SECONDS=0
# {"name":"http://user:pass@host:port"}
# PROXY_POOL={}
# {"youtube":"name"}
# PROXY_DEFAULT_BY_EXTRACTOR={}
# ISO country codes, e.g. US,GB
# GEO_BYPASS_ALLOWLIST=
# SPONSORBLOCK_API_URL=https://sponsor.ajay.app
# SITE_CREDENTIALS_ENABLED=false
# TV_PROVIDER_ENABLED=false
