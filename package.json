{
  "name": "media-service",
  "version": "0.1.0",
  "private": true,
  "description": "Private media service over yt-dlp and ffmpeg: REST API and MCP server (SPEC.md)",
  "license": "UNLICENSED",
  "type": "commonjs",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc --noEmit -p test/e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run --project unit --project integration",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:all",
    "db:generate": "drizzle-kit generate",
    "start:api": "node dist/main.js",
    "cli": "node dist/cli.js",
    "migrate": "node dist/migrate.js",
    "test:live": "vitest run --project live",
    "test:e2e": "pnpm build && playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prometheus-io/client": "^0.16.1",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "@tus/utils": "^0.7.2",
    "bullmq": "6.5.2",
    "drizzle-orm": "^0.45.4",
    "execa": "^10.2.1",
    "fastify": "5.11.3",
    "google-auth-library": "^11.3.2",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "11.2.8",
    "@playwright/test": "1.64.1",
    "@swc/core": "^1.16.20",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "undici": "7.30.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
